    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINO nutzt deinen Standort, um dich zu warnen, wenn du in der Nähe eines gespeicherten Punkts bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINO uses your location to alert you when you are near a saved pin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINO usa tu ubicación para avisarte cuando estás cerca de un punto guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINO utilise ta position pour t’alerter quand tu es près d’un point enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINO usa la posizione per avvisarti quando sei vicino a un punto salvato."
          }
